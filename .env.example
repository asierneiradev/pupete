# ── Pupete · variables de entorno ─────────────────────────────
# Copia a .env y rellena. Nunca subas .env a git.

# URL pública (sin barra final). Se usa en los enlaces de invitación.
APP_URL=https://pupete.example.com

# Secreto largo y aleatorio (>= 32 caracteres). Genera uno con:
#   openssl rand -base64 48
# Cifra los códigos de acceso y firma tokens. Si lo cambias, los códigos
# de acceso existentes dejan de funcionar (hay que regenerarlos).
APP_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Token de primer arranque (recomendado si la app es accesible desde internet).
# Si lo defines, /setup lo pedirá para crear la primera cuenta de admin, así
# nadie puede adelantarse mientras la instalación está vacía.
#   openssl rand -hex 16
SETUP_TOKEN=

# Base de datos PostgreSQL. Con Docker Compose basta con las POSTGRES_*:
# DATABASE_URL se construye sola apuntando al servicio `db`.
POSTGRES_USER=pupete
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=pupete
# Solo para desarrollo sin Docker / CLI de rescate desde el host:
# DATABASE_URL=postgresql://pupete:cambia-esta-contraseña@127.0.0.1:3021/pupete

# Carpeta para fotos subidas. En Docker se fuerza a /app/data/uploads
# (montada en ./data/uploads); en desarrollo, por defecto ./data/uploads.
# UPLOAD_DIR=./data/uploads

# Zona horaria de las fechas de las salas y la cuenta atrás
APP_TIMEZONE=Europe/Madrid

# Puertos en el host (solo 127.0.0.1; delante va tu proxy inverso)
APP_PORT=3020
DB_PORT=3021

# Avisos push del buzón secreto (opcional). Sin estas claves no se ofrecen.
# Genera el par UNA vez y no lo cambies (invalidaría las suscripciones):
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
